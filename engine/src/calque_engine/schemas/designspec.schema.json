{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "BCP 47 code of the text language."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "description": "Token mode of every artboard (a pack's tokens.json $extensions calque.modes); default: the base values.",
      "type": "string"
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "props": {
            "description": "Default value of each {prop}.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "node": {
            "$ref": "#/$defs/__schema0"
          },
          "variants": {
            "description": "Alternative nodes, e.g. primary / secondary.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "node"
        ],
        "additionalProperties": false
      }
    },
    "artboards": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "description": "A core/formats.yaml preset (list_formats), or 'custom' with width and height."
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 8000
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 8000
          },
          "mode": {
            "description": "Token mode for this artboard (e.g. dark); default: the spec's mode.",
            "type": "string"
          },
          "fill": {
            "description": "Background; default: the background role.",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
                "description": "Pack colour role (role.color.<name> in tokens.json), e.g. ink, background, accent, highlight, series.1."
              },
              {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
                    "description": "Pack colour role (role.color.<name> in tokens.json), e.g. ink, background, accent, highlight, series.1."
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "color",
                  "opacity"
                ],
                "additionalProperties": false
              }
            ]
          },
          "layout": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "row",
                  "column"
                ]
              },
              "gap": {
                "type": "number",
                "minimum": 0
              },
              "padding": {
                "description": "px, or [top, right, bottom, left].",
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 4,
                    "maxItems": 4
                  }
                ]
              },
              "align": {
                "description": "Along the direction.",
                "type": "string",
                "enum": [
                  "start",
                  "center",
                  "end",
                  "space_between"
                ]
              },
              "cross": {
                "description": "Across the direction; default start.",
                "type": "string",
                "enum": [
                  "start",
                  "center",
                  "end",
                  "stretch"
                ]
              },
              "wrap": {
                "type": "boolean"
              }
            },
            "required": [
              "direction"
            ],
            "additionalProperties": false
          },
          "children": {
            "default": [],
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "id",
          "format"
        ],
        "additionalProperties": false
      },
      "description": "One per format or per frame of a carousel."
    }
  },
  "required": [
    "pack_id",
    "language",
    "title",
    "artboards"
  ],
  "additionalProperties": false,
